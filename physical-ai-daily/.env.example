# Copy to .env (git-ignored) and fill in. Never commit real values.
ELEVENLABS_API_KEY=
# X discovery (twitterapi.io). Paid per tweet returned.
TWITTERAPI_IO_KEY=
# News discovery (newsdata.io). One key, or a JSON array ["k1","k2"] to pool free-tier quota.
NEWSDATAIO=
# News discovery: NewsData free plan rejects `timeframe` and covers ~36 h.
# Render account key: only for tools/sync_p2a_topics.py (reads the P2A digest topic profiles from prazo5).
RENDER_API_KEY=
