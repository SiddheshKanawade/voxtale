        },
        {
          "narration": "It got there by merging with a SPAC. A special purpose acquisition company: a shell company that lists on the market first, then merges with a private one.",
          "visual": {
            "type": "flow",
            "steps": [
              {
                "icon": "🔤",
                "label": "SPAC",
                "sub": "special purpose acquisition company",
                "cue": "SPAC."
              },
              {
