          "visual": {
            "type": "shot",
            "src": "assets/trr_rev.png",
            "stamp": "The Robot Report"
          }
        },
        {
          "narration": "with a net loss of one hundred thirty-eight point one million.",
          "visual": {
            "type": "stat",
            "items": [
              {
                "from": 1,
                "to": 1,
                "prefix": "$",
                "suffix": ".78M",
                "label": "2025 revenue",
                "cue": "with"
              },
              {
                "to": 138,
                "prefix": "−$",
                "suffix": ".1M",
                "label": "2025 net loss",
                "cue": "loss"
              }
            ]
          }
        },
        {
