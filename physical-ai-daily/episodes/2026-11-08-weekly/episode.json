          },
          "section": "plain"
        },
        {
          "narration": "The deal and related financing raised about four hundred sixty-five million dollars, before expenses.",
          "visual": {
            "type": "shot",
            "src": "assets/ag_465.png"
          },
          "section": "evidence"
        },
        {
