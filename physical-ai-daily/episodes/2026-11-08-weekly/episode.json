              }
            ],
            "credit": "Video stills: Apple HALO project page · robocolosseum.ai"
          }
        },
        {
          "narration": "Plus a big raise for drone delivery, a humanoid maker on the stock market,",
          "visual": {
            "type": "split",
            "items": [
              {
                "src": "assets/zip_photo.png",
                "label": "Zipline raises $1.5B",
                "cue": "drone"
              },
              {
                "src": "assets/ag_aglt.png",
                "label": "Agility lists on Nasdaq",
                "cue": "humanoid"
              }
            ],
            "credit": "Images: Zipline newsroom · Agility Robotics"
          }
        },
        {
          "narration": "and China blocking SoftBank's purchase of ABB's robotics business there.",
          "visual": {
            "type": "photo",
            "src": "assets/abb_arms_c.png",
            "overlay": "China blocks a robotics deal",
            "credit": "Photo: ABB Robotics, via The Robot Report"
          }
        },
        {
          "narration": "This is Pixels to Actions. Every week, we go through what's new in robotics and physical AI.",
          "visual": {
            "type": "kinetic",
            "text": "Pixels2Actions",
            "sub": "Every week: what's new in robotics and physical AI"
          }
        }
      ]
